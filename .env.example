# From https://my.telegram.org under "API development tools"
TG_APP_ID=
TG_APP_HASH=

# 1 = behind an HTTPS reverse proxy (recommended).
# 0 = direct access without a proxy, for example on a home network.
TRUST_PROXY=1

# telegram = normal operation, local = test storage without Telegram
STORAGE_BACKEND=telegram

# Downloads from Telegram: connections per data center (1-16, default 1) and
# file parts read at once (1-32, default 4). Telegram allows about five parts
# of 1 MB a second per account, so more rarely helps. The log shows the speed
# once a minute.
TG_DOWNLOAD_CONNS=
TG_DOWNLOAD_READS=

# Helper bots that download alongside the account, tokens comma separated.
# Each adds about 5 MB/s. They can also be added in the web interface.
TG_BOTS=

# Names or IPs WebDAV clients use to reach the server, comma separated.
# The self-signed WebDAV certificate is made out to them.
WEBDAV_HOSTS=
