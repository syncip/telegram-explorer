# From https://my.telegram.org under "API development tools"
TG_APP_ID=
TG_APP_HASH=

# 1 = behind an HTTPS reverse proxy (recommended).
# 0 = direct access without a proxy, for example on a home network.
TRUST_PROXY=1

# telegram = normal operation, local = test storage without Telegram
STORAGE_BACKEND=telegram

# Downloads from Telegram: connections per data center (1-16, default 4) and
# file parts read at once (1-32, default 8). Only change them to find out what
# Telegram allows your account; the log shows the speed once a minute.
TG_DOWNLOAD_CONNS=
TG_DOWNLOAD_READS=

# Names or IPs WebDAV clients use to reach the server, comma separated.
# The self-signed WebDAV certificate is made out to them.
WEBDAV_HOSTS=
