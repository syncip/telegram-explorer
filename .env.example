# Von https://my.telegram.org unter "API development tools"
TG_APP_ID=
TG_APP_HASH=

# 1 = hinter einem HTTPS-Reverse-Proxy (empfohlen).
# 0 = direkter Zugriff ohne Proxy, zum Beispiel lokal im Heimnetz.
TRUST_PROXY=1

# telegram = normaler Betrieb, local = Testspeicher ohne Telegram
STORAGE_BACKEND=telegram
