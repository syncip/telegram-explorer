<?xml version="1.0" encoding="utf-8"?>
<!-- Telegram Explorer often runs at home under a LAN address without TLS, so plain
     HTTP is allowed. The app warns before it connects to an http:// address. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
